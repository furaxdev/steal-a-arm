-- Marche à suivre : dans Roblox Studio, onglet Avatar > Import (ou le site Créer > Décalcomanies),
-- uploade chaque PNG, puis colle son rbxassetid:// ici — tout le code passe par cette table.
return {
	DuelInvite = "rbxassetid://0", -- assets/icons/duel_invite.png (épées croisées)
	DuelStart = "rbxassetid://0", -- assets/icons/duel_invite.png (même icône pour le début du duel)
	DuelWin = "rbxassetid://0", -- assets/icons/duel_win.png (trophée)
	DuelLose = "rbxassetid://0", -- assets/icons/duel_lose.png (crâne)
	StealSuccess = "rbxassetid://0", -- assets/icons/steal_success.png (dague + étincelles)
	Purchase = "rbxassetid://0", -- assets/icons/purchase.png (sac de pièces)
}
